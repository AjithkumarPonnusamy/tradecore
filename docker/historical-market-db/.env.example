# Historical Market Database Environment Variables
# Copy this file to .env and adjust variables as needed

# Database Connection Details
POSTGRES_DB=historical_market
POSTGRES_USER=market_admin
POSTGRES_PASSWORD=market_admin_secure_pass_123

# Port to expose on the host (avoiding conflict with main DB on 5435)
PORT=5436

# TimescaleDB Settings
# Set to 'off' to disable anonymous telemetry reports
TIMESCALEDB_TELEMETRY=off
